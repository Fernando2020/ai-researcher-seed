# Variáveis de ambiente para rodar a API localmente (`pnpm dev`).
# Copie para `.env` na raiz do repositório — o `.env` é gitignorado.
# Em produção nada disto é lido: o Cloud Run recebe DATABASE_URL do Secret Manager.

# Postgres do docker-compose (`docker compose up -d postgres`).
# O host é `localhost`, não `postgres`: a API do `pnpm dev` roda fora do Docker,
# e o nome do serviço do compose só resolve dentro da rede do próprio Docker.
# Usuário e senha são os do docker-compose.yml — banco local e descartável, não é segredo.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_researcher

# Porta da API. O proxy do Angular (`pnpm dev`) aponta /api para :3000.
PORT=3000

# Provedor de busca web do nó webSearch: `serper` (padrão) ou `google`.
SEARCH_PROVIDER=serper
# Chave do serper.dev. Em produção vem do secret `serper-api-key`. Nunca commite o valor.
SERPER_API_KEY=
# Só se SEARCH_PROVIDER=google: chave da API e ID do mecanismo de busca programável.
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=

# Vertex AI. O código lê GOOGLE_CLOUD_PROJECT_ID, não GOOGLE_CLOUD_PROJECT — essa outra variável é
# genérica e costuma sobrar no ambiente de projetos anteriores, apontando pro projeto errado.
GOOGLE_CLOUD_PROJECT_ID=seu-projeto-gcp
# Os modelos Gemini deste projeto respondem no endpoint global (chat e embeddings).
GOOGLE_CLOUD_LOCATION=global

# Um modelo por papel — trocar o modelo é mudar aqui, nunca no código. Trocar MODEL_EMBEDDING
# invalida o índice inteiro: o `pnpm seed` precisa rodar de novo do zero.
MODEL_GRADE=gemini-3.5-flash-lite
MODEL_ANSWER=gemini-3.6-flash
MODEL_EMBEDDING=gemini-embedding-001

# Modo demonstração: DEMO=true troca só a busca web (provedor e download de página) por fixtures
# em packages/agent/src/demo/. Embeddings, grade e answer continuam na Vertex AI.
DEMO=false
